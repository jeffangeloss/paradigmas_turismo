cabal-version:      2.4
name:               turismo-haskell
version:            0.1.0.0
build-type:         Simple

common warnings
    ghc-options: -Wall
    default-language: Haskell2010

-- Un modulo por funcionalidad de la seccion 4.2, mas las funcionalidades adicionales en src/FA/.
library
    import: warnings
    exposed-modules:
        Tipos
        LecturaCSV
        Rutas
        Reportes
        FA.Samantha
        FA.Melissa
        FA.Jefferson
    hs-source-dirs: src
    build-depends:
        base >=4.12 && <5,
        directory

executable turismo-haskell
    import: warnings
    main-is: Main.hs
    hs-source-dirs: app
    build-depends:
        base >=4.12 && <5,
        turismo-haskell
